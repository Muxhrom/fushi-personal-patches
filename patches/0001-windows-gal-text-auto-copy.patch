+import 'dart:io';
+
+import 'package:drift/native.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:fushi/src/media/sources/reader_fushi_source.dart';
+import 'package:fushi/src/models/app_model.dart';
+import 'package:fushi/src/models/preferences_repository.dart';
+import 'package:fushi/src/settings/settings_context.dart';
+import 'package:fushi/src/settings/settings_destination.dart';
+import 'package:fushi/src/settings/settings_schema_game.dart';
+import 'package:fushi_core/fushi_core.dart';
+
+import '../helpers/test_platform_services.dart';
+
+void main() {
+  testWidgets('game settings toggle writes the auto-copy preference', (
+    WidgetTester tester,
+  ) async {
+    final FushiDatabase db = FushiDatabase.forTesting(NativeDatabase.memory());
+    addTearDown(db.close);
+    final PreferencesRepository preferences = PreferencesRepository(db);
+    await preferences.loadFromDb();
+    final AppModel appModel = AppModel(testPlatformServices())
+      ..wireLocalAudioForTesting(
+        prefsRepo: preferences,
+        databaseDirectory: Directory.systemTemp,
+      )
+      ..wireDatabaseForTesting(db);
+    addTearDown(appModel.dispose);
+    late SettingsContext settingsContext;
+    final SettingsSwitchItem item = buildGameDestination().sections
+        .expand((section) => section.items)
+        .whereType<SettingsSwitchItem>()
+        .singleWhere((item) => item.id == 'game.text_auto_copy');
+    int refreshes = 0;
+    await tester.pumpWidget(
+      ProviderScope(
+        child: MaterialApp(
+          home: Consumer(
+            builder: (BuildContext context, WidgetRef ref, _) {
+              settingsContext = SettingsContext(
+                context: context,
+                appModel: appModel,
+                ref: ref,
+                readerSource: ReaderFushiSource.instance,
+                refresh: () => refreshes++,
+              );
+              return const SizedBox();
+            },
+          ),
+        ),
+      ),
+    );
+    expect(item.value(settingsContext), isFalse);
+    await item.onChanged(settingsContext, true);
+    expect(item.value(settingsContext), isTrue);
+    final PreferencesRepository reopened = PreferencesRepository(db);
+    addTearDown(reopened.dispose);
+    await reopened.loadFromDb();
+    expect(reopened.galTextAutoCopyEnabled, isTrue);
+    await item.onChanged(settingsContext, false);
+    expect(item.value(settingsContext), isFalse);
+    expect(refreshes, 2);
+  });
+}
