@@ -0,0 +1,40 @@
+import 'package:drift/native.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:fushi/src/models/preferences_repository.dart';
+import 'package:fushi_core/fushi_core.dart';
+
+void main() {
+  late FushiDatabase db;
+  late PreferencesRepository preferences;
+
+  setUp(() async {
+    db = FushiDatabase.forTesting(NativeDatabase.memory());
+    preferences = PreferencesRepository(db);
+    await preferences.loadFromDb();
+  });
+
+  tearDown(() async {
+    preferences.dispose();
+    await db.close();
+  });
+
+  test('text auto copy defaults off for existing and new users', () {
+    expect(preferences.galTextAutoCopyEnabled, isFalse);
+  });
+
+  test('enabled and disabled choices survive repository reload', () async {
+    await preferences.setGalTextAutoCopyEnabled(true);
+    expect(preferences.galTextAutoCopyEnabled, isTrue);
+
+    final PreferencesRepository reopened = PreferencesRepository(db);
+    addTearDown(reopened.dispose);
+    await reopened.loadFromDb();
+    expect(reopened.galTextAutoCopyEnabled, isTrue);
+
+    await reopened.setGalTextAutoCopyEnabled(false);
+    expect(reopened.galTextAutoCopyEnabled, isFalse);
+
+    await preferences.loadFromDb();
+    expect(preferences.galTextAutoCopyEnabled, isFalse);
+  });
+}
