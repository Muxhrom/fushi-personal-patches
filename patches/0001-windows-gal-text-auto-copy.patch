diff --git a/fushi/lib/src/mining/gal_text_auto_copy_controller.dart b/fushi/lib/src/mining/gal_text_auto_copy_controller.dart
new file mode 100644
index 0000000000000000000000000000000000000000..91b6bf14113c14b8e73aa640515762034c73caa4
--- /dev/null
+++ b/fushi/lib/src/mining/gal_text_auto_copy_controller.dart
@@ -0,0 +1,92 @@
+import 'dart:async';
+
+import 'package:fushi/src/mining/gal_hook_session_controller.dart';
+import 'package:fushi/src/mining/serial_job_queue.dart';
+import 'package:fushi/src/sync/texthooker_service.dart';
+
+/// Copies newly received, selected game text independently of the workbench UI.
+class GalTextAutoCopyController {
+  GalTextAutoCopyController({
+    required GalHookSessionController session,
+    required Future<void> Function(String text) clipboardWriter,
+    void Function(Object error, StackTrace stack)? onError,
+  }) : _session = session,
+       _clipboardWriter = clipboardWriter,
+       _onError = onError {
+    _rememberLatestLine();
+    _session.addListener(_onSessionChanged);
+  }
+
+  final GalHookSessionController _session;
+  final Future<void> Function(String text) _clipboardWriter;
+  final void Function(Object error, StackTrace stack)? _onError;
+  final SerialJobQueue _queue = SerialJobQueue();
+  bool _enabled = false;
+  bool _disposed = false;
+  int _generation = 0;
+  String? _observedId;
+  String? _observedText;
+
+  bool get enabled => _enabled;
+
+  void setEnabled(bool value) {
+    if (_disposed || _enabled == value) return;
+    _enabled = value;
+    ++_generation;
+    // Switching on never overwrites the clipboard with buffered history.
+    _rememberLatestLine();
+  }
+
+  TexthookerLineEntry? get _latestLine {
+    final List<TexthookerLineEntry> lines = _session.lines;
+    return lines.isEmpty ? null : lines.last;
+  }
+
+  void _rememberLatestLine() {
+    final TexthookerLineEntry? entry = _latestLine;
+    _observedId = entry?.id;
+    _observedText = entry?.text;
+  }
+
+  bool _isSelected(TexthookerLineEntry entry) {
+    final List<TexthookerLineEntry> lines = _session.workbenchLines;
+    return lines.isNotEmpty && lines.last.id == entry.id;
+  }
+
+  void _onSessionChanged() {
+    final TexthookerLineEntry? entry = _latestLine;
+    if (entry?.id == _observedId && entry?.text == _observedText) return;
+    _observedId = entry?.id;
+    _observedText = entry?.text;
+    if (!_enabled || entry == null || !_isSelected(entry)) return;
+
+    final int generation = _generation;
+    final DateTime? startedAt = _session.state.sessionStartedAt;
+    unawaited(
+      _queue.enqueue<void>(
+        () async {
+          // Serialize writes so an older asynchronous copy cannot win. A toggle,
+          // shutdown or new capture session cancels writes that have not started.
+          if (_disposed ||
+              !_enabled ||
+              generation != _generation ||
+              startedAt != _session.state.sessionStartedAt) {
+            return;
+          }
+          final List<TexthookerLineEntry> selected = _session.workbenchLines;
+          if (!selected.any((line) => line.id == entry.id)) return;
+          await _clipboardWriter(entry.text);
+        },
+        buildFailure: (Object error, StackTrace stack) {},
+        onError: _onError,
+      ),
+    );
+  }
+
+  void dispose() {
+    if (_disposed) return;
+    _disposed = true;
+    ++_generation;
+    _session.removeListener(_onSessionChanged);
+  }
+}
