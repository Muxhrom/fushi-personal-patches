diff --git a/fushi/test/mining/gal_text_auto_copy_controller_test.dart b/fushi/test/mining/gal_text_auto_copy_controller_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..29547a75f31561c50bb3bbe1dc0ee3fefc4cc5dd
--- /dev/null
+++ b/fushi/test/mining/gal_text_auto_copy_controller_test.dart
@@ -0,0 +1,270 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:fushi/src/mining/gal_hook_session_controller.dart';
+import 'package:fushi/src/mining/gal_text_auto_copy_controller.dart';
+import 'package:fushi/src/platform/desktop/desktop_clipboard_service.dart';
+import 'package:fushi/src/sync/texthooker_service.dart';
+import 'package:fushi/src/sync/texthooker_ws_client.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  late TexthookerService textService;
+  late ChangeNotifier endpoints;
+  late GalHookSessionController session;
+  late GalTextAutoCopyController autoCopy;
+  late List<String> copied;
+  late List<Object> failures;
+  late Future<void> Function(String text) write;
+
+  setUp(() {
+    textService = TexthookerService.test();
+    endpoints = ChangeNotifier();
+    session = GalHookSessionController(
+      textService: textService,
+      isWindows: false,
+      endpointListenable: endpoints,
+      endpointStatusLoader: () => const <TexthookerEndpointStatus>[],
+    );
+    copied = <String>[];
+    failures = <Object>[];
+    write = (String text) async {
+      copied.add(text);
+    };
+    autoCopy = GalTextAutoCopyController(
+      session: session,
+      clipboardWriter: (String text) => write(text),
+      onError: (Object error, StackTrace stack) => failures.add(error),
+    );
+  });
+
+  tearDown(() async {
+    autoCopy.dispose();
+    await session.close();
+    endpoints.dispose();
+    textService.dispose();
+  });
+
+  Future<void> settleWrites() => Future<void>.delayed(Duration.zero);
+
+  TexthookerLineEntry appendThreadLine(String text, String thread) {
+    return textService.appendLine(
+      text,
+      source: TexthookerLineSource.engineHook,
+      sourceLabel: 'engine_hook',
+      textThreadKey: thread,
+    )!;
+  }
+
+  test(
+    'defaults off and receives text without changing the clipboard',
+    () async {
+      expect(autoCopy.enabled, isFalse);
+      textService.appendLine('テストの台詞です。');
+      await settleWrites();
+      expect(copied, isEmpty);
+    },
+  );
+
+  test(
+    'enabling ignores history and copies the next threadless line',
+    () async {
+      textService.appendLine('以前の台詞です。');
+      autoCopy.setEnabled(true);
+      await settleWrites();
+      expect(copied, isEmpty);
+
+      const String text = '新しい台詞です。\n次の行も残ります。';
+      textService.appendLine(text, source: TexthookerLineSource.websocket);
+      await settleWrites();
+      expect(copied, <String>[text]);
+    },
+  );
+
+  test(
+    'desktop service sends extracted text to the clipboard channel',
+    () async {
+      final List<MethodCall> calls = <MethodCall>[];
+      final messenger =
+          TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+      messenger.setMockMethodCallHandler(SystemChannels.platform, (
+        MethodCall call,
+      ) async {
+        calls.add(call);
+        return null;
+      });
+      addTearDown(
+        () => messenger.setMockMethodCallHandler(SystemChannels.platform, null),
+      );
+      write = DesktopClipboardService().copyToClipboard;
+      autoCopy.setEnabled(true);
+      textService.appendLine('クリップボードへの台詞です。');
+      await settleWrites();
+      expect(calls, hasLength(1));
+      expect(calls.single.method, 'Clipboard.setData');
+      expect(calls.single.arguments, <String, String>{
+        'text': 'クリップボードへの台詞です。',
+      });
+    },
+  );
+
+  test('copies a selected thread but ignores unselected threads', () async {
+    appendThreadLine('選択用の以前の台詞です。', 'thread-a');
+    await session.selectTextThread(1, threadKey: 'thread-a');
+    autoCopy.setEnabled(true);
+
+    appendThreadLine('選択された新しい台詞です。', 'thread-a');
+    await settleWrites();
+    appendThreadLine('別のスレッドの台詞です。', 'thread-b');
+    await settleWrites();
+
+    expect(copied, <String>['選択された新しい台詞です。']);
+  });
+
+  test('thread selection notifications do not copy buffered history', () async {
+    autoCopy.setEnabled(true);
+    appendThreadLine('以前に受信した台詞です。', 'thread-a');
+    await settleWrites();
+    expect(copied, isEmpty);
+
+    await session.selectTextThread(1, threadKey: 'thread-a');
+    await settleWrites();
+    expect(session.workbenchLines, hasLength(1));
+    expect(copied, isEmpty);
+
+    appendThreadLine('選択後に受信した新しい台詞です。', 'thread-a');
+    await settleWrites();
+    expect(copied, <String>['選択後に受信した新しい台詞です。']);
+  });
+
+  test('audio and endpoint notifications do not duplicate a copy', () async {
+    autoCopy.setEnabled(true);
+    final TexthookerLineEntry line = textService.appendLine('同じ台詞です。')!;
+    await settleWrites();
+
+    textService.updateLineAudio(
+      line.id,
+      status: TexthookerLineAudioStatus.matched,
+      backend: 'game_resource',
+      resourceId: 'synthetic.ogg',
+    );
+    endpoints.notifyListeners();
+    await settleWrites();
+    expect(copied, <String>[line.text]);
+  });
+
+  test(
+    'progressive folding copies changed text with the same row id',
+    () async {
+      appendThreadLine('以前の台詞です。', 'thread-a');
+      await session.selectTextThread(1, threadKey: 'thread-a');
+      autoCopy.setEnabled(true);
+      const String first = '今日はいい天気ですね。';
+      const String full = '今日はいい天気ですね。散歩に行きましょう。';
+      final TexthookerLineEntry firstLine = appendThreadLine(first, 'thread-a');
+      await settleWrites();
+      final TexthookerLineEntry updated = appendThreadLine(full, 'thread-a');
+      expect(updated.id, firstLine.id);
+      await settleWrites();
+      expect(copied, <String>[first, full]);
+    },
+  );
+
+  test(
+    'repeated identical text on distinct rows still copies each row',
+    () async {
+      autoCopy.setEnabled(true);
+      final TexthookerLineEntry first = textService.appendLine('はい。')!;
+      final TexthookerLineEntry second = textService.appendLine('はい。')!;
+      expect(second.id, isNot(first.id));
+      await settleWrites();
+      expect(copied, <String>['はい。', 'はい。']);
+    },
+  );
+
+  test('rapid asynchronous clipboard writes remain ordered', () async {
+    final Completer<void> firstStarted = Completer<void>();
+    final Completer<void> releaseFirst = Completer<void>();
+    final List<String> started = <String>[];
+    write = (String text) async {
+      started.add(text);
+      if (text == '一番目。') {
+        firstStarted.complete();
+        await releaseFirst.future;
+      }
+      copied.add(text);
+    };
+    autoCopy.setEnabled(true);
+    textService.appendLine('一番目。');
+    await firstStarted.future;
+    textService.appendLine('二番目。');
+    textService.appendLine('三番目。');
+    await settleWrites();
+    expect(started, <String>['一番目。']);
+
+    releaseFirst.complete();
+    await settleWrites();
+    expect(copied, <String>['一番目。', '二番目。', '三番目。']);
+  });
+
+  for (final bool dispose in <bool>[false, true]) {
+    test('${dispose ? 'dispose' : 'disable'} cancels queued writes', () async {
+      final Completer<void> firstStarted = Completer<void>();
+      final Completer<void> releaseFirst = Completer<void>();
+      write = (String text) async {
+        if (text == '実行中の台詞です。') {
+          firstStarted.complete();
+          await releaseFirst.future;
+        }
+        copied.add(text);
+      };
+      autoCopy.setEnabled(true);
+      textService.appendLine('実行中の台詞です。');
+      await firstStarted.future;
+      textService.appendLine('待機中の台詞です。');
+      if (dispose) {
+        autoCopy.dispose();
+      } else {
+        autoCopy.setEnabled(false);
+      }
+      releaseFirst.complete();
+      await settleWrites();
+      textService.appendLine('停止後の台詞です。');
+      await settleWrites();
+      expect(copied, <String>['実行中の台詞です。']);
+    });
+  }
+
+  test('reenabling does not replay text received while disabled', () async {
+    autoCopy.setEnabled(true);
+    textService.appendLine('開始時の台詞です。');
+    await settleWrites();
+    autoCopy.setEnabled(false);
+    textService.appendLine('無効の間の台詞です。');
+    autoCopy.setEnabled(true);
+    endpoints.notifyListeners();
+    await settleWrites();
+    expect(copied, <String>['開始時の台詞です。']);
+
+    textService.appendLine('再開後の台詞です。');
+    await settleWrites();
+    expect(copied, <String>['開始時の台詞です。', '再開後の台詞です。']);
+  });
+
+  test('a clipboard failure does not block the next line', () async {
+    final StateError failure = StateError('clipboard temporarily unavailable');
+    write = (String text) async {
+      if (text == '失敗する台詞です。') throw failure;
+      copied.add(text);
+    };
+    autoCopy.setEnabled(true);
+    textService.appendLine('失敗する台詞です。');
+    textService.appendLine('次の台詞です。');
+    await settleWrites();
+    expect(failures, <Object>[failure]);
+    expect(copied, <String>['次の台詞です。']);
+  });
+}
